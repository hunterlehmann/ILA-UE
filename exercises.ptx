\subsection{6.2, Orthogonal complements}

<exercises>
  <exercise>
    <statement>
      <p>What is the dimension of <m>W^{\perp}</m> if <m>W</m> is a line in <m>{\bf R}^{10}</m>?</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>What is <m>W^{\perp}</m> if <m>W</m> is the line <m>y = mx</m> (<m>m</m> some real number) in <m>{\bf R}^2</m>?</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>If <m>W</m> is the line <m>y=x</m> in <m>{\bf R}^2</m>, and <m>v = \begin{pmatrix}7 \\ -3\end{pmatrix}</m>, write <m>v</m> as <m>v_W + v_{W^{\perp}}</m>.</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Find the orthogonal complement of the line through the origin and <m>\begin{pmatrix}1 \\ 2 \\ 3\end{pmatrix}</m> in <m>{\bf R}^3</m>.</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Find the orthogonal complement of the line through the origin and <m>\begin{pmatrix}1 \\ 2 \\ 3 \\ 4\end{pmatrix}</m> in <m>{\bf R}^4</m>.</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Find the orthogonal complement of the <m>x_1x_2</m>-plane in <m>{\bf R}^4</m>?</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Suppose <m>A</m> is a <m>22 \times 17</m> matrix with rank <m>10</m>.
      \newline \newline
      (i) Write the dimension of the null space of <m>A</m>:
      \underline{\hspace{2cm}} \newline \newline
      (ii) Write the dimension of the the row space of <m>A</m>:
      \underline{\hspace{2cm}} \newline \newline
      (iii) Write the dimension of <m>(\textup{Row } A)^{\perp}</m>:
      \underline{\hspace{2cm}} \newline \newline
      (iv) Write the dimension of <m>(\textup{Col } A)^{\perp}</m>:
      \underline{\hspace{2cm}}</p>
    </statement>
  </exercise>
