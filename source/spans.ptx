  \draw[vector, seq3] (0,0,0) --
    \u node [right] {$u$};
  \draw[thin, densely dotted] \u -- \projxy\u;

  \draw[thin, densely dotted] \v -- \w;

  \point at (0,0,0);
\end{scope}

\end{tikzpicture}
            ]]></latex-image>
        </image>
      </figure>
      
            <question>
        <title>Span of two vectors in <m>\R^2</m></title>
