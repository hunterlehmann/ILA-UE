  <example>
    <title>Area of a triangle</title>
    <idx><h>Triangle</h><h>area of</h><see>Volume</see></idx>
    <idx><h>Volume</h><h>of a triangle</h></idx>
    <statement>
      <p>
        Find the area of the triangle with vertices
        <m>(-1,-2), \,(2,-1),\,(1,3).</m>
        </p>
<image width="60%">
<shortdescription>
<!-- FILL: Brief alt-text for this TikZ figure (linear algebra context) -->
</shortdescription>
<description>
<p>
<!-- FILL: Complete accessibility description of this TikZ figure for a linear algebra course -->
</p>
</description>
