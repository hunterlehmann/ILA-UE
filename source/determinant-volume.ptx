\end{pmatrix}$} (2,-1);
  \draw[vector] (-1,-2) -- node[auto,whitebg,behind path] {$\begin{pmatrix}
2 \\
5
\end{pmatrix}$} (1,3);
\end{tikzpicture}
        </latex-image>
</image>
<p>
        The area of the parallelogram is
        <md>
<mrow>\left|\det\begin{pmatrix}
2 \amp 5 \\
3 \amp 1
\end{pmatrix}\right| = |2-15| = 13</mrow>
</md>,
        so the area of the triangle is <m>13/2</m>.
      </p>
    </solution>
  </example>

  <p>
    You might be wondering: if the absolute value of the determinant is a volume, what is the geometric meaning of the determinant without the absolute value?  The next remark explains that we can think of the determinant as a <em>signed</em> volume.  If you have taken an integral calculus course, you probably computed negative areas under curves; the idea here is similar.
  </p>

  <remark>
    <title>Signed volumes</title>
    <idx><h>Volume</h><h>signed</h></idx>
    <p>
      The <xref ref="det-is-volume"/> on determinants and volumes tells us that the <em>absolute value</em> of the determinant is the volume of a paralellepiped.  This raises the question of whether the sign of the determinant has any geometric meaning.
    </p>
    <p>
      A <m>1\times 1</m> matrix <m>A</m> is just a number <m>\mat a</m>.  In this case, the parallelepiped <m>P</m> determined by its one row is just the interval <m>[0,a]</m> if <m>a \geq 0</m>, and it is <m>[a,0]</m> if <m>a\lt0</m>.  In this case, the sign of the determinant determines whether the interval is to the left or the right of the origin.
    </p>
    <p>
      For a <m>2\times 2</m> matrix with rows <m>v_1,v_2</m>, the sign of the determinant determines whether <m>v_2</m> is counterclockwise or clockwise from <m>v_1</m>.  That is, if the counterclockwise angle from <m>v_1</m> to <m>v_2</m> is less than <m>180^\circ</m>, then the determinant is positive; otherwise it is negative (or zero).
      <latex-code>
        <![CDATA[
\usetikzlibrary{angles}
\begin{tikzpicture}[thin border nodes, scale=1.3]
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0) -- (1,2) -- (3,3) -- (2,1) -- cycle;
  \draw[vector] (0,0) -- node[auto]{$v_2$} (1,2);
  \draw[vector] (0,0) -- node[auto,swap]{$v_1$} (2,1);
  \coordinate (o) at (0,0);
  \coordinate (v1) at (2,1);
  \coordinate (v2) at (1,2);
  \pic[draw, ->, angle radius=1cm] {angle=v1--o--v2};
  \node at (1.5,-.7) {$\det\begin{pmatrix}
\matrow{v_1} \\
\matrow{v_2}
\end{pmatrix} > 0$};
\end{tikzpicture}
\qquad
\begin{tikzpicture}[thin border nodes, scale=1.3]
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0) -- (1,2) -- (3,3) -- (2,1) -- cycle;
  \draw[vector] (0,0) -- node[auto]{$v_1$} (1,2);
  \draw[vector] (0,0) -- node[auto,swap]{$v_2$} (2,1);
  \coordinate (o) at (0,0);
  \coordinate (v1) at (2,1);
  \coordinate (v2) at (1,2);
  \pic[draw, <-, angle radius=1cm] {angle=v1--o--v2};
  \node at (1.5,-.7) {$\det\begin{pmatrix}
\matrow{v_1} \\
\matrow{v_2}
\end{pmatrix} < 0$};
  \end{tikzpicture}
        ]]>
      </latex-code>
      For example, if <m>v_1 = {a\choose b}</m>, then the counterclockwise rotation of <m>v_1</m> by <m>90^\circ</m> is <m>v_2 = {-b\choose a}</m> by <xref ref="linear-trans-rotation-matrix"/>, and
      <md>
<mrow>\det\begin{pmatrix}
a \amp b \\
-b \amp a
\end{pmatrix} = a^2 + b^2 > 0</mrow>
</md>.
      On the other hand, the <em>clockwise</em> rotation of <m>v_1</m> by <m>90^\circ</m> is <m>b\choose -a</m>, and
      <md>
<mrow>\det\begin{pmatrix}
a \amp b \\
b \amp -a
\end{pmatrix} = -a^2 - b^2 \lt 0</mrow>
</md>.
    </p>
    <p>
      For a <m>3\times 3</m> matrix with rows <m>v_1,v_2,v_3</m>, the <em>right-hand rule</em> determines the sign of the determinant.  If you point the index finger of your right hand in the direction of <m>v_1</m> and your middle finger in the direction of <m>v_2</m>, then the determinant is positive if your thumb points roughly in the direction of <m>v_3</m>, and it is negative otherwise.
      </p>
<image width="60%">
<shortdescription>
<!-- FILL: Brief alt-text for this TikZ figure (linear algebra context) -->
</shortdescription>
<description>
<p>
<!-- FILL: Complete accessibility description of this TikZ figure for a linear algebra course -->
</p>
</description>
<latex-image>
\begin{tikzpicture}[thin border nodes, myxyz, scale=2]
  \filldraw[fill=seq-orange, opacity=.2, very thin]
    (0,0,0) -- (-1,0,0) -- (-1,.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, opacity=.2, very thin]
    (0,0,0) -- (-1,0,0) -- (-.8,1,0) -- (.2,1,0) -- cycle;
  \filldraw[fill=seq-orange, opacity=.2, shift={(-1,0,0)}, very thin]
    (0,0,0) -- (.2,1,0) -- (.2,1.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0,0) -- (.2,1,0) -- (.2,1.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, shift={(.2,1,0)}, very thin]
    (0,0,0) -- (-1,0,0) -- (-1,.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, shift={(0,.3,1)}, very thin]
    (0,0,0) -- (-1,0,0) -- (-.8,1,0) -- (.2,1,0) -- cycle;
  \draw[vector] (0,0,0) -- node[auto,swap] {$v_1$} (.2,1,0);
  \draw[vector, opacity=.4] (0,0,0) -- node[auto] {$v_2$} (-1,0,0);
  \draw[vector] (0,0,0) -- node[auto] {$v_3$} (0,.3,1);
  \node[resetxy] at (1,-.75) {$\det\begin{pmatrix}
\matrow{v_1} \\
\matrow{v_2} \\
\matrow{v_3}
\end{pmatrix}>0$};
\end{tikzpicture}
\qquad
\begin{tikzpicture}[thin border nodes, myxyz, scale=2]
  \filldraw[fill=seq-orange, opacity=.2, very thin]
    (0,0,0) -- (-1,0,0) -- (-1,.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, opacity=.2, very thin]
    (0,0,0) -- (-1,0,0) -- (-.8,1,0) -- (.2,1,0) -- cycle;
  \filldraw[fill=seq-orange, opacity=.2, shift={(-1,0,0)}, very thin]
    (0,0,0) -- (.2,1,0) -- (.2,1.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0,0) -- (.2,1,0) -- (.2,1.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, shift={(.2,1,0)}, very thin]
    (0,0,0) -- (-1,0,0) -- (-1,.3,1) -- (0,.3,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, shift={(0,.3,1)}, very thin]
    (0,0,0) -- (-1,0,0) -- (-.8,1,0) -- (.2,1,0) -- cycle;
  \draw[vector] (0,0,0) -- node[auto,swap] {$v_2$} (.2,1,0);
  \draw[vector, opacity=.4] (0,0,0) -- node[auto] {$v_1$} (-1,0,0);
  \draw[vector] (0,0,0) -- node[auto] {$v_3$} (0,.3,1);
  \node[resetxy] at (1,-.75) {$\det\begin{pmatrix}
\matrow{v_1} \\
\matrow{v_2} \\
\matrow{v_3}
\end{pmatrix}\lt0$};
\end{tikzpicture}
      </latex-image>
</image>
    <p>
      In higher dimensions, the notion of signed volume is still important, but it is usually <em>defined</em> in terms of the sign of a determinant.
    </p>
  </remark>

  </subsection>


  <subsection xml:id="subsec-volumes-of-regions">
    <title>Volumes of Regions</title>

    <p>
      Let <m>A</m> be an <m>n\times n</m> matrix with columns <m>v_1,v_2,\ldots,v_n</m>, and let <m>T\colon\R^n\to\R^n</m> be the associated <xref ref="matrix-trans-defn-of" text="title">matrix transformation</xref> <m>T(x)=Ax</m>.  Then <m>T(e_1)=v_1</m> and <m>T(e_2)=v_2</m>, so <m>T</m> takes the unit cube <m>C</m> to the parallelepiped <m>P</m> determined by <m>v_1,v_2,\ldots,v_n</m>:
      </p>
<image width="60%">
<shortdescription>
<!-- FILL: Brief alt-text for this TikZ figure (linear algebra context) -->
</shortdescription>
<description>
<p>
<!-- FILL: Complete accessibility description of this TikZ figure for a linear algebra course -->
</p>
</description>
<latex-image>
\begin{tikzpicture}[thin border nodes, scale=1.3]
  \begin{scope}[scale=1.7, yshift=.3cm]
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0) -- (1,0) -- (1,1) -- (0,1) -- cycle;
  \node at (.5, .5) {$C$};
  \draw[vector] (0,0) -- node[auto]{$e_2$} (0,1);
  \draw[vector, opacity=.75] (0,0) -- node[auto,swap]{$e_1$} (1,0);
  \coordinate (a) at (1.2, .5);
  \end{scope}

  \draw[->, thick] (a) to[bend left]
      node[above=2pt] {$T$}
      node[below=4pt] {$\begin{pmatrix}
| \amp | \\
v_1 \amp v_2 \\
| \amp |
\end{pmatrix}$}
      ($(a) + (2.8cm,0)$);

  \begin{scope}[xshift=5cm]
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0) -- (1,2) -- (3,3) -- (2,1) -- cycle;
  \draw[vector] (0,0) -- node[auto]{$v_2$} (1,2);
  \draw[vector] (0,0) -- node[auto,swap]{$v_1$} (2,1);
  \node at (1.5, 1.5) {$P$};
  \end{scope}
\end{tikzpicture}
      </latex-image>
</image>
<p>
      Since the unit cube has volume <m>1</m> and its image has volume <m>|\det(A)|</m>, the transformation <m>T</m> scaled the volume of the cube by a factor of <m>|\det(A)|</m>.  To rephrase:
    </p>

    <assemblage>
      <p>
        If <m>A</m> is an <m>n\times n</m> matrix with corresponding matrix transformation <m>T\colon\R^n\to\R^n</m>, and if <m>C</m> is the unit cube in <m>\R^n</m>, then the volume of <m>T(C)</m> is <m>|\det(A)|.</m>
      </p>
    </assemblage>

    <p>
      <notation><usage><m>T(S)</m></usage><description>The image of a region under a transformation</description></notation>
      The notation <m>T(S)</m> means the image of the region <m>S</m> under the transformation <m>T</m>.  In <xref ref="set-builder-notation" text="title">set builder notation</xref>, this is the subset
      <md>
<mrow>T(S) = \bigl\{T(x)\mid x \text{ in } S\bigr\}</mrow>
</md>.
    </p>

    <p>
      In fact, <m>T</m> scales the volume of <em>any</em> region in <m>\R^n</m> by the same factor, even for curvy regions.
    </p>

    <theorem xml:id="det-vol-regions">
      <idx><h>Volume</h><h>of a region</h></idx>
      <idx><h>Matrix transformation</h><h>and volumes</h></idx>
      <idx><h>Linear transformation</h><h>and volumes</h><see>Matrix transformation</see></idx>
      <statement>
        <p>
          Let <m>A</m> be an <m>n\times n</m> matrix, and let <m>T\colon\R^n\to\R^n</m> be the associated matrix transformation <m>T(x)=Ax</m>.  If <m>S</m> is any region in <m>\R^n</m>, then
          <md>
<mrow>\vol(T(S))=|\det(A)|\cdot\vol(S)</mrow>
</md>.
        </p>
      </statement>
      <proof visible="true">
        <p>
          Let <m>C</m> be the unit cube, let <m>v_1,v_2,\ldots,v_n</m> be the columns of <m>A</m>, and let <m>P</m> be the paralellepiped determined by these vectors, so <m>T(C) = P</m> and <m>\vol(P) = |\det(A)|</m>.  For <m>\epsilon > 0</m> we let <m>\epsilon C</m> be the cube with side lengths <m>\epsilon</m>, i.e., the paralellepiped determined by the vectors <m>\epsilon e_1,\epsilon e_2,\ldots,\epsilon e_n</m>, and we define <m>\epsilon P</m> similarly.  By the second <xref ref="linear-trans-defn" text="title">defining property</xref>, <m>T</m> takes <m>\epsilon C</m> to <m>\epsilon P</m>.  The volume of <m>\epsilon C</m> is <m>\epsilon^n</m> (we scaled each of the <m>n</m> standard vectors by a factor of <m>\epsilon</m>) and the volume of <m>\epsilon P</m> is <m>\epsilon^n|\det(A)|</m> (for the same reason), so we have shown that <m>T</m> scales the volume of <m>\epsilon C</m> by <m>|\det(A)|</m>.
          </p>
<image width="60%">
<shortdescription>
<!-- FILL: Brief alt-text for this TikZ figure (linear algebra context) -->
</shortdescription>
<description>
<p>
<!-- FILL: Complete accessibility description of this TikZ figure for a linear algebra course -->
</p>
</description>
<latex-image>
\begin{tikzpicture}[thin border nodes, scale=1.3]
  \begin{scope}[scale=1.7, yshift=.3cm]
  \filldraw[very thin, black!50!white, fill=seq-orange!10!white]
    (0,0) -- (1,0) -- (1,1) -- (0,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0) -- (.6,0) -- (.6,.6) -- (0,.6) -- cycle;
  \draw[vector, black!50!white] (0, 0) -- (1, 0);
  \draw[vector, black!50!white] (0, 0) -- (0, 1);
  \draw[vector] (0,0) -- node[auto]{$\epsilon e_2$} (0,.6);
  \draw[vector, opacity=.75] (0,0) -- node[auto,swap]{$\epsilon e_1$} (.6,0);
  \node at (.3, .3) {$\epsilon C$};
  \coordinate (a) at (1.2, .5);
  \end{scope}

  \node at (1.7/2, -.5) {$\vol(\epsilon C) = \epsilon^n$};

  \draw[->, thick] (a) to[bend left]
      node[above=2pt] {$T$}
      node[below=4pt] {$\begin{pmatrix}
| \amp | \\
v_1 \amp v_2 \\
| \amp |
\end{pmatrix}$}
      ($(a) + (2.8cm,0)$);

  \begin{scope}[xshift=5cm]
  \filldraw[black!50!white, fill=seq-orange!10!white, very thin]
    (0,0) -- (1,2) -- (3,3) -- (2,1) -- cycle;
  \filldraw[fill=seq-orange, fill opacity=.2, very thin]
    (0,0) -- (.6,1.2) -- (1.8,1.8) -- (1.2,.6) -- cycle;
  \draw[vector, black!50!white] (0, 0) -- (1,2);
  \draw[vector, black!50!white] (0, 0) -- (2,1);
  \draw[vector] (0,0) -- node[auto]{$\epsilon v_2$} (.6,1.2);
  \draw[vector] (0,0) -- node[auto,swap]{$\epsilon v_1$} (1.2,.6);
  \node at (.9,.9) {$\epsilon P$};
  \end{scope}

  \node at (6.3, -.5) {$\vol(\epsilon P) = \epsilon^n|\det(A)|$};
\end{tikzpicture}
          </latex-image>
</image>
        <p>
          By the first <xref ref="linear-trans-defn" text="title">defining property</xref>, the image of a translate of <m>\epsilon C</m> is a translate of <m>\epsilon P</m>:
          <md>
<mrow>T(x + \epsilon C) = T(x) + \epsilon T(C) = T(x) + \epsilon P</mrow>
</md>.
          Since a translation does not change volumes, this proves that <m>T</m> scales the volume of a translate of <m>\epsilon C</m> by <m>|\det(A)|</m>.
        </p>
        <p>
          At this point, we need to use techniques from multivariable calculus, so we only give an idea of the rest of the proof.  Any region <m>S</m> can be approximated by a collection of very small cubes of the form <m>x + \epsilon C</m>.  The image <m>T(S)</m> is then approximated by the image of this collection of cubes, which is a collection of very small paralellepipeds of the form <m>T(x) + \epsilon P</m>.
          <latex-code>
\def\curvy{(-37.3333, 2.6667)
     .. controls (-37.3333, -5.3333) and (-26.6667, -10.6667) .. (-16, -24)
     .. controls (-5.3333, -37.3333) and (5.3333, -58.6667) .. (18.6667, -48)
     .. controls (32, -37.3333) and (48, 5.3333) .. (45.3333, 18.6667)
     .. controls (42.6667, 32) and (21.3333, 16) .. (8, 13.3333)
     .. controls (-5.3333, 10.6667) and (-10.6667, 21.3333) .. (-18.6667, 21.3333)
     .. controls (-26.6667, 21.3333) and (-37.3333, 10.6667) .. cycle}

\begin{tikzpicture}[scale=1, thin border nodes]
  \draw[help lines, black!25] (-2,-2) rectangle (2,2);
  \begin{scope}[fill=seq-orange, fill opacity=.2, thin,
      x=1.7*.7bp, y=1.7*.7bp, yshift=.4cm, xshift=-.2cm]
    \expandafter\filldraw\curvy;
    \expandafter\clip\curvy;
    \fill[seq-red, opacity=.5, shift={(2*4,-4*4)}] (0,0) rectangle (4,4);
    \coordinate (a) at (2*4,-4*4);
    \draw[very thin, black!70!white, step=4] (-60,-60) grid (60,60);
  \end{scope}

  \draw[thin] (-1.2, -1.2) node[below] {$x + \epsilon C$} -- (a);

  \node at (0,1.5) {$S$};
  %\point at (0,0);

  \draw[->, thick] (2.1,0) to[bend left, "$T$" above=1mm]
    (8-2.1,0);

  \begin{scope}[xshift=8cm]
    \draw[help lines, black!25] (-2,-2) rectangle (2,2);
    \begin{scope}[cm={2,1,1,2,(0,.5)}, x=.7bp, y=.7bp,
        fill=seq-orange, fill opacity=.2, thin]
      \expandafter\filldraw\curvy;
      \expandafter\clip\curvy;
      \fill[seq-red, opacity=.5, shift={(2*4,-4*4)}] (0,0) rectangle (4,4);
      \draw[very thin, black!70!white, step=4] (-60,-60) grid (60,60);
    \coordinate (b) at (3*4,-4*4);
  \end{scope}

  \draw[thin] (.9,-1.3) node[below] {$T(x) + \epsilon P$} -- (b);

  \node at (-.7,1.5) {$T(S)$};
  % \point at (0,0);
  \end{scope}
\end{tikzpicture}
          </latex-code>
          The volume of <m>S</m> is closely approximated by the sum of the volumes of the cubes; in fact, as <m>\epsilon</m> goes to zero, the limit of this sum is precisely <m>\vol(S)</m>.  Likewise, the volume of <m>T(S)</m> is equal to the sum of the volumes of the paralellepipeds, take in the limit as <m>\epsilon\to 0</m>.  The key point is that <em>the volume of each cube is scaled by <m>|\det(A)|</m>.</em>  Therefore, the sum of the volumes of the paralellepipeds is <m>|\det(A)|</m> times the sum of the volumes of the cubes.  This proves that <m>\vol(T(S)) = |\det(A)|\vol(S).</m>
        </p>
      </proof>
    </theorem>

    <example>
      <statement>
        <p>
          Let <m>S</m> be a half-circle of radius <m>1</m>, let
          <md>
<mrow>A = \begin{pmatrix}
1 \amp 2 \\
2 \amp 1
\end{pmatrix}</mrow>
</md>,
          and define <m>T\colon\R^2\to\R^2</m> by <m>T(x)=Ax</m>.  What is the area of <m>T(S)</m>?
          </p>
<image width="60%">
<shortdescription>
<!-- FILL: Brief alt-text for this TikZ figure (linear algebra context) -->
</shortdescription>
<description>
<p>
<!-- FILL: Complete accessibility description of this TikZ figure for a linear algebra course -->
</p>
</description>
<latex-image>
\begin{tikzpicture}
  \begin{scope}[yshift=-.3cm]
    \draw[grid lines] (-1.5,-.5) grid (1.5, 1.5);
    \filldraw[fill=seq-orange, fill opacity=.2, thin]
      (1,0) arc[start angle=0, end angle=180, radius=1] -- cycle;
    \node at (0,.5) {$S$};
  \end{scope}

  \draw[->, thick] (2.1,0) to[bend left, "$T$" above=1mm]
    node[below=1mm]{$\begin{pmatrix}
1 \amp 2 \\
2 \amp 1
\end{pmatrix}$} (7-2.1,0);

  \begin{scope}[xshift=7cm]
    \draw[grid lines] (-1.5,-2.5) grid (2.5, 2.5);
    \begin{scope}[cm={1,2,2,1,(0,0)}]
      \filldraw[fill=seq-orange, fill opacity=.2, thin]
        (1,0) arc[start angle=0, end angle=180, radius=1] -- cycle;
      \node at (0,.5) {$T(S)$};
    \end{scope}
  \end{scope}

\end{tikzpicture}
          </latex-image>
</image>
      </statement>
      <solution>
        <p>
          The area of the unit circle is <m>\pi</m>, so the area of <m>S</m> is <m>\pi/2</m>.  The transformation <m>T</m> scales areas by a factor of <m>|\det(A)| = |1 - 4| = 3</m>, so
          <md>
<mrow>\vol(T(S)) = 3\vol(S) = \frac{3\pi}2</mrow>
</md>.
        </p>
      </solution>
    </example>

    <example>
      <title>Area of an ellipse</title>
      <idx><h>Volume</h><h>of an ellipse</h></idx>
      <idx><h>Ellipse</h><h>area of</h><see>Volume</see></idx>
      <statement>
        <p>
          Find the area of the interior <m>E</m> of the ellipse defined by the equation
          <md>
<mrow>\left(\frac{2x-y}{2}\right)^2 + \left(\frac{y+3x}{3}\right)^2 = 1</mrow>
</md>.
        </p>
      </statement>
      <solution>
        <p>
          This ellipse is obtained from the unit circle <m>X^2+Y^2=1</m> by the linear change of coordinates
          <md>
<mrow>X \amp= \frac{2x-y}2</mrow>
<mrow>Y \amp= \frac{y+3x}3</mrow>
</md>.
          In other words, if we define a linear transformation <m>T\colon\R^2\to\R^2</m> by
          <md>
<mrow>T\begin{pmatrix}
x \\
y
\end{pmatrix} = \begin{pmatrix}
(2x-y)/2 \\
(y+3x)/3
\end{pmatrix}</mrow>
</md>,
          then <m>T{x\choose y}</m> lies on the unit circle <m>C</m> whenever <m>x\choose y</m> lies on <m>E</m>.
          </p>
<image width="60%">
<shortdescription>
<!-- FILL: Brief alt-text for this TikZ figure (linear algebra context) -->
</shortdescription>
<description>
<p>
<!-- FILL: Complete accessibility description of this TikZ figure for a linear algebra course -->
</p>
</description>
<latex-image>
\begin{tikzpicture}
  \begin{scope}[xshift=7cm]
    \draw[grid lines] (-1.5,-1.5) grid (1.5, 1.5);
    \filldraw[fill=seq-orange, fill opacity=.2, thin]
      (0,0) circle[radius=1];
    \node at (0,0) {$C$};
  \end{scope}

  \draw[->, thick] (2.1,0) to[bend left, "$T$" above=1mm]
    node[below=2mm]{$\begin{pmatrix}
1 \amp -1/2 \\
1 \amp 1/3
\end{pmatrix}$} (7-2.1,0);

  \begin{scope}[xshift=0cm]
    \draw[grid lines] (-1.5,-2.5) grid (1.5, 2.5);
    \begin{scope}[cm={2/5,-6/5,3/5,6/5,(0,0)}]
      \filldraw[fill=seq-orange, fill opacity=.2, thin]
        (0,0) circle[radius=1];
      \node at (0,0) {$E$};
    \end{scope}
  \end{scope}

\end{tikzpicture}
          </latex-image>
</image>
<p>
          We compute the standard matrix <m>A</m> for <m>T</m> by evaluating on the standard coordinate vectors:
          <md>
<mrow>T\begin{pmatrix}
1 \\
0
\end{pmatrix} = \begin{pmatrix}
1 \\
1
\end{pmatrix} \qquad T\begin{pmatrix}
0 \\
1
\end{pmatrix} = \begin{pmatrix}
-1/2 \\
1/3
\end{pmatrix}
            \quad\implies\quad A = \begin{pmatrix}
1 \amp -1/2 \\
1 \amp 1/3
\end{pmatrix}</mrow>
</md>.
          Therefore, <m>T</m> scales areas by a factor of <m>|\det(A)| = |\frac13+\frac12| = \frac56.</m>  The area of the unit circle is <m>\pi</m>, so
          <md>
<mrow>\pi = \vol(C) = \vol(T(E)) = |\det(A)|\cdot\vol(E) = \frac56\vol(E)</mrow>
</md>,
          and thus the area of <m>E</m> is <m>6\pi/5</m>.
        </p>
      </solution>
    </example>

    <remark>
      <title>Multiplicativity of <m>|\det|\,</m></title>
      <idx><h>Determinant</h><h>multiplicativity property</h><h>and volumes</h></idx>
    <p>
      The above <xref ref="det-vol-regions"/> also gives a geometric reason for multiplicativity of the (absolute value of the) determinant.  Indeed, let <m>A</m> and <m>B</m> be <m>n\times n</m> matrices, and let <m>T,U\colon\R^n\to\R^n</m> be the corresponding matrix transformations.  If <m>C</m> is the unit cube, then
      <md>
<mrow>\vol\bigl(T\circ U(C)\bigr) = \vol\bigl(T(U(C))\bigr)
        \amp= |\det(A)|\vol(U(C))</mrow>
<mrow>\amp= |\det(A)|\cdot|\det(B)|\vol(C)</mrow>
<mrow>\amp= |\det(A)|\cdot|\det(B)|</mrow>
</md>.
      On the other hand, the matrix for the composition <m>T\circ U</m> is the product <m>AB</m>, so
      <md>
<mrow>\vol\bigl(T\circ U(C)\bigr) = |\det(AB)|\vol(C) = |\det(AB)|</mrow>
</md>.
      Thus <m>|\det(AB)| = |\det(A)|\cdot|\det(B)|</m>.
    </p>
    </remark>

  </subsection>
<exercises>
  <exercise>
    <statement>
      <p>Suppose we are given two vectors <m>u</m> and <m>v</m> in <m>{\bf R}^{2}</m> and asked to compute
      the area of their associated parallelogram, but the computation yields <m>0</m> as the answer.
      What does this mean?</p>
    </statement>
    <solution>
      <p>If <m>0 = |\det\begin{pmatrix}u \amp v\end{pmatrix}|</m>, then <m>u</m> and <m>v</m> are linearly dependent, so they do
        not actually form a parallelogram.  Instead, since they are on the same line
        through the origin, they only form a portion of a line, which has <m>0</m> area in
        <m>{\bf R}^{2}</m>.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find the area of the parallelogram determined by the vectors
        <md><mrow>v_1 = \begin{pmatrix}1 \\ -3\end{pmatrix}, \quad v_2 = \begin{pmatrix}2 \\ 4\end{pmatrix}</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>The area is <m>\left|\det\begin{pmatrix}v_1 \amp v_2\end{pmatrix} \right|=
        \left|\det\begin{pmatrix}1 \amp 2 \\ -3 \amp 4\end{pmatrix}\right| = \left|1(4)-2(-3)\right| = 10</m>.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find the area of the parallelogram with vertices
        <md><mrow>(1, 2), \quad (3, 7), \quad (4, -1),  \quad (6, 4)</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>To use the formula from section 4.2, we need to find vectors <m>v_1</m> and <m>v_2</m>
        that determine the area of the parallelogram. For this, we can start at any
        vertex (we will use the first vertex) and find the vectors to each of its two
        adjacent vertices within the parallelogram.</p>
      <p>The vector from <m>(1,2)</m> to <m>(3, 7)</m> is <m>v_1 = \begin{pmatrix}2 \\ 5\end{pmatrix}</m>.</p>
      <p>The vector from <m>(1,2)</m> to <m>(4, -1)</m> is <m>v_2 = \begin{pmatrix}3 \\ -3\end{pmatrix}</m>.</p>
      <p>
        The area is
        <md><mrow>\left|\det\begin{pmatrix}v_1 \amp v_2\end{pmatrix}\right| = \left|\det\begin{pmatrix}2 \amp 3 \\ 5 \amp -3\end{pmatrix}\right| =
            |2(-3)-3(5)| = |-21| = 21</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find the area of the triangle with vertices
        <md><mrow>(4,-5), \quad (1, 2), \quad (-10, -3)</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>The area is half of the area of the corresponding parallelogram.  To use the
        formula from section 4.2, we need to find vectors <m>v_1</m> and <m>v_2</m> that
        determine the triangle. For this, we can start at any vertex
        (we will use the first vertex) and find the vectors to each of its two
        adjacent vertices within the triangle.</p>
      <p>The vector from <m>(4, -5)</m> to <m>(1, 2)</m> is <m>v_1 = \begin{pmatrix}-3 \\ 7\end{pmatrix}</m>.</p>
      <p>The vector from <m>(4, -5)</m> to <m>(-10, -3)</m> is <m>v_2 = \begin{pmatrix}-14 \\ 2\end{pmatrix}</m>.</p>
      <p>
        The area is
        <md>
          <mrow>\dfrac{1}{2} \left|\det\begin{pmatrix}v_1 \amp v_2\end{pmatrix}\right|
            \amp  = \dfrac{1}{2} \left|\det\begin{pmatrix}-3 \amp -14</mrow>
          <mrow>7 \amp 2\end{pmatrix}\right|
            = \dfrac{1}{2}\left|(-3)(2)-(-14)(7)\right|</mrow>
          <mrow>\amp  = \dfrac{1}{2}\left|-6 + 98\right| = \dfrac{1}{2}(92) = 46</mrow>
        </md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find the volume of the parallelepiped <m>P</m> naturally determined by the three
        vectors below.
        <md><mrow>v_1 = \begin{pmatrix}1 \\ 0 \\ 0\end{pmatrix}, \quad v_2 = \begin{pmatrix}-1 \\ 7 \\ 3\end{pmatrix}, \quad v_3 = \begin{pmatrix}2 \\ 4 \\ 6\end{pmatrix}</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        The volume is
        <md><mrow>\left|\det\begin{pmatrix}1 \amp -1 \amp 2 \\ 0 \amp 7 \amp 4 \\ 0 \amp 3 \amp 6\end{pmatrix}\right| =
          |1(7(6)-3(4)) - (-1)(0-0) + 2(0-0)| = 30</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find the volume of the parallelepiped <m>P</m> naturally determined by the four
        vectors below.
        <md><mrow>v_1 = \begin{pmatrix}4 \\ 4 \\ 1 \\ 2\end{pmatrix}, \quad v_2 = \begin{pmatrix}0 \\ 20 \\ 1 \\ 0\end{pmatrix}, \quad v_3 = \begin{pmatrix}-1 \\ -1 \\ 1 \\ 1\end{pmatrix},
          \quad v_4 = \begin{pmatrix}5 \\ 5 \\ 3 \\ 4\end{pmatrix}</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        The volume is
        <md>
          <mrow>\left|\det\begin{pmatrix}4 \amp 0 \amp -1 \amp 5</mrow>
          <mrow>4 \amp 20 \amp -1 \amp 5</mrow>
          <mrow>1 \amp 1 \amp 1 \amp 3</mrow>
          <mrow>2 \amp 0 \amp 1 \amp 4\end{pmatrix}\right|
          \amp  = \left| 0C_{21} + 20C_{22} + 1C_{32} + 0 C_{42}\right|</mrow>
          <mrow>\amp  = \left| 20 \det\begin{pmatrix}4 \amp -1 \amp 5</mrow>
          <mrow>1 \amp 1 \amp 3</mrow>
          <mrow>2 \amp 1 \amp 4\end{pmatrix} +
            1(-1)^{3+2} \det \begin{pmatrix}4 \amp -1 \amp 5</mrow>
          <mrow>4 \amp -1 \amp 5</mrow>
          <mrow>2 \amp 0 \amp 4\end{pmatrix}\right|</mrow>
          <mrow>\amp  = \left| 20 \Big[4(4-3)+1(4-6)+5(1-2)\Big] -1 (0)\right| = \left|20(4-2-5)\right|</mrow>
          <mrow>\amp  = 60</mrow>
        </md>.
        Above, we did not need to do any work to compute <m>C_{42}</m> because its
        <m>3 \times 3</m> matrix had two identical rows and thus had determinant <m>0</m>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find all values of <m>h</m> so that the volume of the parallelepiped <m>P</m> formed by the
        four vectors below is equal to <m>15</m>.
        <md><mrow>v_1 = \begin{pmatrix}-2 \\ 0 \\ h \\ 0\end{pmatrix}, \qquad
          v_2 = \begin{pmatrix}4 \\ 1 \\ 1 \\ 0\end{pmatrix}, \qquad
          v_3 = \begin{pmatrix}0 \\ 2 \\ 1 \\ 9\end{pmatrix}, \qquad
          v_4 = \begin{pmatrix}6 \\ 4 \\ 5 \\ 1\end{pmatrix}</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        There are two values of <m>h</m> that work: <m>h = 5/82</m> and <m>h = 35/82</m>.  The volume
          of <m>P</m> is the absolute value of the determinant of the matrix with columns
          <m>v_1</m> through <m>v_4</m>, so we set it equal to <m>15</m> and solve for <m>h</m>.  We use the
          cofactor expansion along the first column.
        <md>
          <mrow>15 \amp  = \left|\det\begin{pmatrix}-2 \amp 4 \amp 0 \amp 6</mrow>
          <mrow>0 \amp 1 \amp 2 \amp 4</mrow>
          <mrow>h \amp 1 \amp 1 \amp 5</mrow>
          <mrow>0 \amp 0 \amp 9 \amp 1\end{pmatrix}\right|
                 = \left|-2C_{11} + 0 C_{21} + h C_{31} + 0 C_{41}\right|</mrow>
          <mrow>\amp  = \left|-2(-1)^{1+1} \det\begin{pmatrix}1 \amp 2 \amp 4</mrow>
          <mrow>1 \amp 1 \amp 5</mrow>
          <mrow>0 \amp 9 \amp 1\end{pmatrix} + h(-1)^{3+1}
                 \det\begin{pmatrix}4 \amp 0 \amp 6</mrow>
          <mrow>1 \amp 2 \amp 4</mrow>
          <mrow>0 \amp 9 \amp 1\end{pmatrix}\right|</mrow>
          <mrow>\amp  = \left| -2 \Big[1(1-9\cdot 5)-2(1-0)+4(9-0)\Big]
                 + h \Big[4(2\cdot 1-9 \cdot 4)-0+6(1 \cdot 9 -0)\Big] \right|</mrow>
          <mrow>\amp  = \left| -2(-44-2+36) + h(-136+54)\right|</mrow>
          <mrow>\amp  = \left|-2(-10) - 82h\right| = \left|20-82h\right|</mrow>
        </md>.
        Therefore, <m>\left|20-82h\right| = 15</m>.
      </p>
      <p>Case 1: <m>20-82h = 15</m>, so <m>82h = 5</m> and <m>h = 5/82</m>.</p>
      <p>Case 2: <m>-(20-82h) = 15</m>, so <m>-20+82h = 15</m>, thus <m>82h = 35</m>
        and <m>h = 35/82</m>.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Let <m>R</m> be the triangle with vertices <m>(0, 0)</m>, <m>(1, 4)</m>, and <m>(10, 20)</m>.  Find
      the area of the new triangle <m>T(R)</m>, where <m>T: {\bf R}^2 \to {\bf R}^2</m> is the
      transformation <m>T(x) = \begin{pmatrix}8 \amp -3 \\ 1 \amp 2\end{pmatrix}</m>.</p>
    </statement>
    <solution>
      <p>
        The area of <m>R</m> is
        <md><mrow>\dfrac{1}{2} \left| \det\begin{pmatrix}1 \amp 10 \\ 4 \amp 20\end{pmatrix}\right| = \dfrac{1}{2}|-20| = 10</mrow></md>.
        Let <m>A = \begin{pmatrix}8 \amp -3 \\ 1 \amp 2\end{pmatrix}</m>, noting <m>|\det(A)| = 19</m>.  From the area formula from
          chapter 4, we know
        <md><mrow>\textup{Area}(T(R)) = \left|\det(A)\right|\cdot \textup{Area}(R)
            = 19(10) = 190</mrow></md>.
        Another way to do this problem is to transform the vertices of the original triangle
          into the new triangle: we compute <m>T\begin{pmatrix}0 \\ 0\end{pmatrix} = \begin{pmatrix}0 \\ 0\end{pmatrix}</m>,
        <md><mrow>T\begin{pmatrix}1 \\ 4\end{pmatrix} = \begin{pmatrix}8 \amp -3 \\ 1 \amp 2\end{pmatrix} \begin{pmatrix}1 \\ 4\end{pmatrix} = \begin{pmatrix}-4 \\ 9\end{pmatrix}, \qquad
            T\begin{pmatrix}10 \\ 20\end{pmatrix} = \begin{pmatrix}8 \amp -3 \\ 1 \amp 2\end{pmatrix} \begin{pmatrix}10 \\ 20\end{pmatrix} = \begin{pmatrix}20 \\ 50\end{pmatrix}</mrow></md>.
        Therefore, the vertices of <m>T(R)</m> are <m>(0, 0)</m>, <m>(-4,9)</m>, and <m>(20,50)</m>.
        <md><mrow>\textup{Area}(T(R)) = \dfrac{1}{2}
            \left|\det\begin{pmatrix}-4 \amp 20 \\ 9 \amp 50\end{pmatrix}\right| = \dfrac{1}{2} |-200-180| = \dfrac{1}{2}(380)
            = 190</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Let <m>T: {\bf R}^2 \to {\bf R}^2</m> be the transformation
        <md><mrow>T(x) = \begin{pmatrix}7 \amp -1 \\ 0 \amp 3\end{pmatrix} x</mrow></md>.
        Find the area of <m>T(C)</m>, where <m>C</m> is the circle
        of radius <m>2</m> centered at the origin.
      </p>
    </statement>
    <solution>
      <p>
        With <m>A = \begin{pmatrix}7 \amp -1 \\ 0 \amp 3\end{pmatrix}</m>, we use the area formula from section 4.3:
        <md><mrow>\textup{Area}(T(C)) = \left| \det(A) \right| \textup{Area}(C)
          = 21 \cdot (\pi(2^2)) = 84 \pi</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>If the area of a fish (in a photo) is <m>7</m> square inches, and if we apply the
        shear transformation <m>T(x) = \begin{pmatrix}1 \amp 13 \\ 0 \amp 1\end{pmatrix}</m> to the photo, what is the area
        of the fish in the new photo?</p>
    </statement>
    <solution>
      <p>To get the area of the new fish, we multiply the original area by the
        determinant of the standard matrix for <m>T</m>.  The new area is
        <m>\det\begin{pmatrix}1 \amp 13 \\ 0 \amp 1\end{pmatrix} \cdot 7 = 1 \cdot 7 = 7</m>.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Suppose <m>u</m> and <m>v</m> are vectors in <m>{\bf R}^2</m> that naturally form a
      parallelogram with area <m>10</m> square units.  What is the area of the
      parallelogram naturally formed by <m>3u</m> and <m>-v</m>. Justify this answer
      in two ways: first by using geometry, then by using properties of
      determinants.</p>
    </statement>
    <solution>
      <p>Geometrically: stretching <m>u</m> by a factor of three will scale the
        area by a factor of <m>3</m>, whereas multiplying <m>v</m> by <m>-1</m> will only
        change the direction of facing of the parallelogram.  Therefore, the
        resulting area is <m>3(10)=30</m>.</p>
      <p>
        Determinants: the area of the parallelogram determined by <m>u</m> and
          <m>v</m> is
        <md><mrow>\textup{Area} = \left|\det \begin{pmatrix}- \amp u \amp - \\ - \amp v \amp -\end{pmatrix}\right|=10 \textup{
               units}^2</mrow></md>.
        Scaling a row of a matrix by <m>3</m> multiplies the
           determinant by <m>3</m>, and multiplying a row by <m>-1</m> changes the
           determinant by <m>-1</m> (this will be irrelevant since we take the
           absolute value).
        <md><mrow>\textup{Area} = \left|\det \begin{pmatrix}- \amp 3u \amp - \\ - \amp -v \amp -\end{pmatrix}\right| =
             |10(3)(-1)| = 30 \textup{ units}^2</mrow></md>.
      </p>
    </solution>
  </exercise>
</exercises>
</section>
