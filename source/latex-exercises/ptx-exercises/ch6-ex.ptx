\subsection{6.1, Dot products and orthogonality}

<exercises>
  <exercise>
    <statement>
      <p>Compute the dot product of the vectors <m>\begin{pmatrix}-3 \\ 1 \\ 2 \\ 1\end{pmatrix}</m> and
      <m>\begin{pmatrix}0 \\ 2 \\ -4 \\ 3\end{pmatrix}</m>.</p>
    </statement>
    <solution>
      <p><m>\begin{pmatrix}-3 \\ 1 \\ 2 \\ 1\end{pmatrix} \cdot \begin{pmatrix}0 \\ 2 \\ -4 \\ 3\end{pmatrix}
        = -3(0) + 1(2) + 2(-4) + 1(3) = -3</m>.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Suppose <m>u</m> and <m>v</m> are vectors satisfying <m>||u|| = 3</m>,
        <m>||v|| = 9</m>, and <m>u \cdot v = -4</m>.  Find
        <md><mrow>(4u-v) \cdot (u + v)</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        <md>
          <mrow>(4u-v) \cdot (u + v)
            \amp  = 4 u \cdot u + 4u \cdot v - v \dot u - v \dot v</mrow>
          <mrow>\amp  = 4 ||u||^2 + 4 (-4) - (-4) - ||v||^2</mrow>
          <mrow>\amp  = 4 (3^2) - 16 + 4 - 9^2
              = -57</mrow>
        </md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Suppose <m>u</m> and <m>v</m> are vectors satisfying <m>||u|| = 4</m>
        and <m>||v|| = 2</m>.  Find
        <md><mrow>||u+v||^2 + ||u-v||^2</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        We could expand the expression or use the Parallelogram Law.
        <md><mrow>||u+v||^2 + ||u-v||^2 = 2(||u||^2 + ||v||^2)
            = 2(16 + 4) = 40</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Suppose <m>u</m>, <m>v</m>, and <m>w</m> are vectors with the property that
      <m>u \perp v</m> and <m>u \perp w</m>.  Must it be true that <m>u</m> is orthogonal
      to all vectors in <m>\textup{Span}\{v, w\}</m>?  Justify your answer.</p>
    </statement>
  </exercise>
  <exercise>
    <introduction>
      <p>
        (Challenge!) We can define dot products outside of our usual
        context of <m>{\bf R}^n</m>.  This example discusses a dot product on the
        set <m>W</m> of all polynomials of degree <m>3</m> or less, defined as follows.
        If <m>f</m> and <m>g</m> are in <m>W</m>, we define a dot product using integration:
        <md><mrow>f \cdot g = \int_{-1} ^1 f(x) g(x) \ dx</mrow></md>.
      </p>
    </introduction>
    <task>
      <statement>
        <p>Let <m>f(x) = x</m> and <m>g(x) = x^2</m>.  Show that <m>f</m> and <m>g</m>
          are orthogonal.  In other words, show that <m>f \cdot g = 0</m>.</p>
      </statement>
      <solution>
        <p><m>\displaystyle f \cdot g = \int_{-1}^1 x(x^2) \ dx = \int_{-1}^1
            x^3 \ dx = x^4 \Big|_{-1}^1 = 1 - 1 = 0</m>.</p>
      </solution>
    </task>
    <task>
      <statement>
        <p>Let <m>f(x) = x</m> and <m>g(x) = x^3 - cx</m>.  Find the value
          of <m>c</m> so that <m>f</m> and <m>g</m> are orthogonal.</p>
      </statement>
      <solution>
        <p>
          We solve for <m>c</m> so that <m>f \cdot g = 0</m>.
          <md><mrow>0 = f \cdot g = \int_{-1}^1 x(x^3 - cx) \ dx
                = \int_{-1}^1 x^4 - cx^2
                = \Big[\dfrac{x^5}{5} - \dfrac{1}{3}cx^3\Big]_{-1}^1
                = \dfrac{2}{5} - \dfrac{2}{3}c</mrow></md>.
          Therefore, <m>c = \dfrac{3}{5}</m>.
        </p>
      </solution>
    </task>
  </exercise>
</exercises>\setcounter{problem}{0}

\newpage

\subsection{6.2, Orthogonal complements}

<exercises>
  <exercise>
    <statement>
      <p>What is the dimension of <m>W^{\perp}</m> if <m>W</m> is a line in <m>{\bf R}^{10}</m>?</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>What is <m>W^{\perp}</m> if <m>W</m> is the line <m>y = mx</m> (<m>m</m> some real number) in <m>{\bf R}^2</m>?</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>If <m>W</m> is the line <m>y=x</m> in <m>{\bf R}^2</m>, and <m>v = \begin{pmatrix}7 \\ -3\end{pmatrix}</m>, write <m>v</m> as <m>v_W + v_{W^{\perp}}</m>.</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Find the orthogonal complement of the line through the origin and <m>\begin{pmatrix}1 \\ 2 \\ 3\end{pmatrix}</m> in <m>{\bf R}^3</m>.</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Find the orthogonal complement of the line through the origin and <m>\begin{pmatrix}1 \\ 2 \\ 3 \\ 4\end{pmatrix}</m> in <m>{\bf R}^4</m>.</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Find the orthogonal complement of the <m>x_1x_2</m>-plane in <m>{\bf R}^4</m>?</p>
    </statement>
  </exercise>
  <exercise>
    <statement>
      <p>Suppose <m>A</m> is a <m>22 \times 17</m> matrix with rank <m>10</m>.</p>
      <p>(i) Write the dimension of the null space of <m>A</m>:
      \underline{\hspace{2cm}}</p>
      <p>(ii) Write the dimension of the the row space of <m>A</m>:
      \underline{\hspace{2cm}}</p>
      <p>(iii) Write the dimension of <m>(\textup{Row } A)^{\perp}</m>:
      \underline{\hspace{2cm}}</p>
      <p>(iv) Write the dimension of <m>(\textup{Col } A)^{\perp}</m>:
      \underline{\hspace{2cm}}</p>
    </statement>
  </exercise>
</exercises>\setcounter{problem}{0}


