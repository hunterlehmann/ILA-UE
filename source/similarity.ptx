      \draw[seq-blue,   opacity=1, vector] (0,0) -- (0,1) node[left] {$v_2'$};
    \end{scope}

    \point at (0, 0);
  \end{scope}

  \begin{scope}[yshift=-9cm, xshift=9cm]
