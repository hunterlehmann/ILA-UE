    0 \& 0 \& 0 \& 0 \\
  }
  ;

  \node [blue box=(m1-1-1)] (bm1-1-1) {};
  \node [contrastBlue, above=1mm of m1-1-1, anchor=south west, xshift=-1cm, align=left]
    (expl1) {Get a $1$ here};

  \node [blue box=(m2-1-1)] (bm2-1-1) {};
  \node [contrastBlue, above=1mm of m2-1-1, anchor=south west, xshift=-5mm, align=left]
    (expl2) {Clear down};
  \draw[->, contrastBlue, very thick, opacity=.5] (bm2-1-1.south) -- (m2-4-1.south);

  \node [blue box=(m3-2-2)] (bm3-2-2) {};
  \node [contrastBlue, above=1mm of m3-1-2, anchor=south, xshift=-.65mm, align=center]
    (expl3) {Get a $1$ here};
  \draw[->, contrastBlue, rounded corners=.5mm]
      (expl3.215) |- (bm3-2-2.west);

  \node [blue box=(m4-2-2)] (bm4-2-2) {};
  \node [contrastBlue, above=1mm of m4-1-1, anchor=south west, xshift=-5mm, align=left]
    (expl4) {Clear down};
  \draw[->, contrastBlue, very thick, opacity=.5] (bm4-2-2.south) -- (m4-4-2.south);

  \node [blue box=(m5-3-3) (m5-4-3)] (bm5-2) {};
  \node [contrastBlue, above=1mm of m5-1-3, anchor=south, xshift=-.55mm, align=center]
    (expl6) {(maybe these are already zero)};
  \draw[->, contrastBlue, rounded corners=.5mm]
      (expl6.215) |- (bm5-2.west);

  \node [blue box=(m6-3-4)] (bm6-3-4) {};
  \node [contrastBlue, above=1mm of m6-1-4, anchor=south, xshift=-5mm, align=center]
    (expl7) {Get a $1$ here};
  \draw[->, contrastBlue, rounded corners=.5mm]
      (expl7.215) |- (bm6-3-4.west);

  \node [blue box=(m7-3-4)] (bm7-3-4) {};
  \node [contrastBlue, above=1mm of m7-1-4, anchor=south, xshift=-5mm, align=left]
    (expl8) {Clear down};
  \draw[->, contrastBlue, very thick, opacity=.5] (bm7-3-4.south) -- (m7-4-4.south);

  \node [contrastBlue, above=1mm of m8-1-2.north east, anchor=south, align=center, xshift=1mm]
    (expl9) {Matrix is in REF};

  \node [blue box=(m9-3-4)] (bm9-3-4) {};
  \node [contrastBlue, above=1mm of m9-1-4, anchor=south, xshift=-5mm, align=left]
    (expl10) {Clear up};
  \draw[->, contrastBlue, very thick, opacity=.5] (bm9-3-4.north) -- (m9-1-4.north);

  \node [blue box=(m10-2-2)] (bm10-2-2) {};
  \node [contrastBlue, above=1mm of m10-1-2, anchor=south, xshift=-2mm, align=left]
    (expl11) {Clear up};
  \draw[->, contrastBlue, very thick, opacity=.5] (bm10-2-2.north) -- (m10-1-2.north);

  \node [contrastBlue, above=1mm of m11-1-2.north east, anchor=south, align=center, xshift=1mm]
    (expl9) {Matrix is in RREF};


  \node [contrastBlue, below=2cm of m9-4-2.south east, anchor=north, align=center, xshift=1mm]
    (expl9) {};

\end{tikzpicture}
          ]]></latex-image>
</image>

        <p>
          It will be very important to know where are the pivots of a matrix after row reducing; this is the reason for the following piece of terminology.
        </p>

        <definition xml:id="defn-pivot-pos">
          <title>Pivots</title>
          <idx><h>Pivot position</h></idx>
          <statement>
            <p>
              A <term>pivot position</term> of a matrix is an entry that is a pivot of a row echelon form of that matrix.
            </p>
            <p>
              A <term>pivot column</term> of a matrix is a column that contains a pivot position.
            </p>
          </statement>
        </definition>

        <example xml:id="pivot-pos-eg">
          <title>Pivot Positions</title>
      <statement>
      <p>Find the pivot positions and pivot columns of this matrix
      <md>
<mrow>A = \left(\begin{array}{rrr|r}
0 \amp -7 \amp -4 \amp 2 \\
2 \amp 4 \amp 6 \amp 12 \\
3 \amp 1 \amp -1 \amp -2
\end{array}\right).</mrow>
</md>
      </p>
      </statement>
      <solution>
        <p>We saw in <xref ref="row-reduction-eg1"/> that a row echelon form of the matrix is
        <md>
<mrow>\left(\begin{array}{rrr|r}
1 \amp 2 \amp 3 \amp 6 \\
0 \amp 1 \amp 2 \amp 4 \\
0 \amp 0 \amp 10 \amp 30
\end{array}\right).</mrow>
</md>
        The pivot positions of <m>A</m> are the entries that become pivots in a row echelon form; they are marked in color below:
        <md>
<mrow>\left(\begin{array}{rrr|r}
\mh{0} \amp -7 \amp -4 \amp 2 \\
2 \amp \mh{4} \amp 6 \amp 12 \\
3 \amp 1 \amp \mh{-1} \amp -2
\end{array}\right).</mrow>
</md>
        The first, second, and third columns are pivot columns.
      </p>
    </solution>
    </example>

        <example xml:id="row-reduction-eg-inconsistent">
          <title>An Inconsistent System</title>
          <statement>
            <p>Solve the linear system
            <md>
<mrow>\left\{\begin{alignedat}{3}
2x \amp {}+{} \amp 10y \amp {}={} \amp -1 \amp {} \\
3x \amp {}+{} \amp 15y \amp {}={} \amp 2 \amp {}
\end{alignedat}\right.</mrow>
</md>
            using row reduction.
            </p>
          </statement>
          <solution>
            <p>
              <md>
                <mrow>
                  \left(\begin{array}{rr|r}
2 \amp {10} \amp {-1} \\
3 \amp {15} \amp 2
\end{array}\right)
                  \quad\xrightarrow{R_1=R_1\div 2}\quad
                  \amp\left(\begin{array}{rr|r}
\mh{1}\amp 5 \amp {-\frac 12} \\
3 \amp {15} \amp 2
\end{array}\right)
                  \,\mhb{\text{(Step 1b)}}
                </mrow>
                <mrow>
                  {}\quad\xrightarrow{R_2=R_2-3R_1}\quad
                  \amp\left(\begin{array}{rr|r}
1 \amp 5 \amp {-\frac 12} \\
\mh{0}\amp 0 \amp \frac72
\end{array}\right)
                  \,\mhb{\text{(Step 1c)}}
                </mrow>
                <mrow>
                  {}\quad\xrightarrow{R_2=R_2\times\frac 27}\quad
                  \amp\left(\begin{array}{rr|r}
1 \amp 5 \amp {-\frac 12} \\
0 \amp 0 \amp \mh{1}
\end{array}\right)
                  \,\mhb{\text{(Step 2b)}}
                </mrow>
                <mrow>
                  {}\quad\xrightarrow{R_1=R_1+\frac 12R_2}\quad
                  \amp\left(\begin{array}{rr|r}
1 \amp 5 \amp \mh{0}\\
0 \amp 0 \amp 1
\end{array}\right)
                  \,\mhb{\text{(Step 2c)}}
                </mrow>
              </md>
              This row reduced matrix corresponds to the <em>inconsistent</em> system
              <md>
<mrow>\left\{\begin{alignedat}{3}
x \amp {}+{} \amp 5y \amp {}={} \amp 0 \amp {} \\
{} \amp {} \amp 0 \amp {}={} \amp 1. \amp {}
\end{alignedat}\right.</mrow>
</md>
            </p>
          </solution>
        </example>

    <p>
      In the above example, we saw how to recognize the reduced row echelon form of an inconsistent system.
    </p>

    <theorem>
      <title>The Row Echelon Form of an Inconsistent System</title>
      <idx><h>System of linear equations</h><h>inconsistent</h><h>RREF criterion</h></idx>
      <p>An augmented matrix corresponds to an inconsistent system of equations if and only if the last column (i.e., the augmented column) is a <em>pivot column</em>.</p>
    </theorem>

    <p>In other words, the row reduced matrix of an inconsistent system looks like this:
    <md>
<mrow>\left(\begin{array}{rrrr|r}
1 \amp 0 \amp \star \amp \star \amp \mh{0}\\
0 \amp 1 \amp \star \amp \star \amp \mh{0}\\
0 \amp 0 \amp 0 \amp 0 \amp \mh{1}
\end{array}\right)</mrow>
</md>
    </p>

    <p>
      We have discussed two classes of matrices so far:
      <ol>
        <li>
          When the reduced row echelon form of a matrix has a pivot in every non-augmented column, then it corresponds to a system with a unique solution:
          <md>
<mrow>\left(\begin{array}{rrr|r}
1 \amp 0 \amp 0 \amp 1 \\
0 \amp 1 \amp 0 \amp -2 \\
0 \amp 0 \amp 1 \amp 3
\end{array}\right)
          \quad\xrightarrow{\text{translates to}}\quad
          \left\{\begin{alignedat}{4}
x \amp {} \amp {} \amp {} \amp {} \amp {}={} \amp 1 \amp {} \\
{} \amp {} \amp y \amp {} \amp {} \amp {}={} \amp -2 \amp {} \\
{} \amp {} \amp {} \amp {} \amp z \amp {}={} \amp 3. \amp {}
\end{alignedat}\right.</mrow>
</md>
        </li>
        <li>
          When the reduced row echelon form of a matrix has a pivot in the last (augmented) column, then it corresponds to a system with a no solutions:
          <md>
<mrow>\left(\begin{array}{rr|r}
1 \amp 5 \amp 0 \\
0 \amp 0 \amp 1
\end{array}\right)\quad\xrightarrow{\text{translates to}}\quad
            \left\{\begin{alignedat}{3}
x \amp {}+{} \amp 5y \amp {}={} \amp 0 \amp {} \\
{} \amp {} \amp 0 \amp {}={} \amp 1. \amp {}
\end{alignedat}\right.</mrow>
</md>
        </li>
      </ol>
      What happens when one of the non-augmented columns lacks a pivot?  This is the subject of <xref ref="sec-parametric-form" text="type-global"/>.
    </p>

    <example>
      <title>A System with Many Solutions</title>
      <statement>
        <p>Solve the linear system
        <md>
<mrow>\left\{\begin{alignedat}{4}
2x \amp {}+{} \amp y \amp {}+{} \amp 12z \amp {}={} \amp 1 \amp {} \\
x \amp {}+{} \amp 2y \amp {}+{} \amp 9z \amp {}={} \amp -1 \amp {}
\end{alignedat}\right.</mrow>
</md>
        using row reduction.
        </p>
      </statement>
      <solution>
        <p>
          <md>
            <mrow>
              \left(\begin{array}{rrr|r}
2 \amp 1 \amp 12 \amp 1 \\
1 \amp 2 \amp 9 \amp -1
\end{array}\right)
              \quad\xrightarrow{R_1 \longleftrightarrow R_2}\quad
              \amp\left(\begin{array}{rrr|r}
\mh{1}\amp 2 \amp 9 \amp -1 \\
2 \amp 1 \amp 12 \amp 1
\end{array}\right)
              \,\mhb{\text{(Optional)}}
            </mrow>
            <mrow>
              {}\quad\xrightarrow{R_2=R_2-2R_1}\quad
              \amp\left(\begin{array}{rrr|r}
1 \amp 2 \amp 9 \amp -1 \\
\mh{0}\amp -3 \amp -6 \amp 3
\end{array}\right)
              \,\mhb{\text{(Step 1c)}}
            </mrow>
            <mrow>
              {}\quad\xrightarrow{R_2=R_2\div -3}\quad
              \amp\left(\begin{array}{rrr|r}
1 \amp 2 \amp 9 \amp -1 \\
0 \amp \mh{1}\amp 2 \amp -1
\end{array}\right)
              \,\mhb{\text{(Step 2b)}}
            </mrow>
            <mrow>
              {}\quad\xrightarrow{R_1=R_1-2R_2}\quad
              \amp\left(\begin{array}{rrr|r}
1 \amp \mh{0}\amp 5 \amp 1 \\
0 \amp 1 \amp 2 \amp -1
\end{array}\right)
              \,\mhb{\text{(Step 2c)}}
            </mrow>
          </md>
          This row reduced matrix corresponds to the linear system
          <md>
<mrow>\left\{\begin{alignedat}{3}
x \amp {}+{} \amp 5z \amp {}={} \amp 1 \amp {} \\
y \amp {}+{} \amp 2z \amp {}={} \amp -1. \amp {}
\end{alignedat}\right.</mrow>
</md>
          In what sense is the system solved?  We will see in <xref text="type-global" ref="sec-parametric-form"/>.
        </p>
      </solution>
    </example>

  </subsection>
<exercises>
  <exercise>
    <statement correct="yes">
      <p>The augmented matrix <m>\left(\begin{array}{rrr|r}0 \amp 1 \amp 0 \amp 2 \\ 0 \amp 0 \amp 1 \amp -3\end{array}\right)</m> is
        in reduced row echelon form.</p>
    </statement>
    <solution>
      <p>True.  The second and third columns are the pivot
            columns, and the matrix satisfies all conditions for RREF.</p>
    </solution>
  </exercise>
  <exercise>
    <statement correct="no">
      <p>If the reduced row echelon form of an augmented matrix has a row of
          zeros, then the system of linear equations corresponding to the
          augmented matrix must have infinitely many solutions.</p>
    </statement>
    <solution>
      <p>
        False.  For example, consider the augmented matrix
        <md><mrow>\left(\begin{array}{rr|r}0 \amp 0 \amp 1 \\ 0 \amp 0 \amp 0\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Is the following matrix in reduced row echelon
          form (RREF)?  If not, row reduce to put it in RREF.
        <md><mrow>\left(\begin{array}{rr|r}1 \amp -2 \amp 4 \\ 0 \amp 0 \amp 0\end{array}\right)</mrow></md>
      </p>
    </statement>
    <solution>
      <p>The matrix is in RREF.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Is the following matrix in reduced row echelon
          form (RREF)?  If not, row reduce to put it in RREF.
        <md><mrow>\left(\begin{array}{rrr|r}0 \amp 1 \amp 2 \amp 3 \\ 0 \amp 0 \amp 1 \amp 4\end{array}\right)</mrow></md>
      </p>
    </statement>
    <solution>
      <p>
        The matrix is not in RREF because the pivot in the second line has a <q>2</q> in its column.  To put the matrix in RREF, we need to do one row operation:
        <md><mrow>\left(\begin{array}{rrr|r}0 \amp 1 \amp 2 \amp 3 \\ 0 \amp 0 \amp 1 \amp 4\end{array}\right)
            \xrightarrow[]{R_1 = R_1 - 2 R_2}
            \left(\begin{array}{rrr|r}0 \amp 1 \amp 0 \amp -5 \\ 0 \amp 0 \amp 1 \amp 4\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Is the following matrix in reduced row echelon
          form (RREF)?  If not, row reduce to put it in RREF.
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp 1 \\ 0 \amp 1 \amp 0 \amp 1 \\ 0 \amp 0 \amp 1 \amp 0 \\ 0 \amp 0 \amp 0 \amp 1\end{array}\right)</mrow></md>
      </p>
    </statement>
    <solution>
      <p>
        No.  The rightmost column is a pivot column (with
              pivot in the fourth row), but the column has nonzero entries in
              its first and second row.
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp 1 \\ 0 \amp 1 \amp 0 \amp 1 \\ 0 \amp 0 \amp 1 \amp 0 \\ 0 \amp 0 \amp 0 \amp 1\end{array}\right)
                \xrightarrow[R_1 = R_1 - R_4]{R_2 = R_2 - R_4}
                \left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp 0 \\ 0 \amp 1 \amp 0 \amp 0 \\ 0 \amp 0 \amp 1 \amp 0 \\ 0 \amp 0 \amp 0 \amp 1\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Put the following matrix into reduced row
        echelon form (RREF).  Indicate which columns are pivot columns.
        <m>\begin{pmatrix}3 \amp -9 \amp 0 \amp 3 \\ 1 \amp -3 \amp 1 \amp -4 \\ 4 \amp -12 \amp 2 \amp -6\end{pmatrix}</m>.</p>
    </statement>
    <solution>
      <p>Try this problem using the Interactive Row Reducer
          <url href="https://textbooks.math.gatech.edu/ila/demos/rrinter.html?mat=3,-9,0,3:1,-3,1,-4:4,-12,2,-6">here</url>.</p>
      <p>
        Columns 1 and 3 are the pivot columns, and the RREF of the matrix
            is
        <md><mrow>\begin{pmatrix}1 \amp -3 \amp 0 \amp 1 \\ 0 \amp 0 \amp 1 \amp -5 \\ 0 \amp 0 \amp 0 \amp 0\end{pmatrix}</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Put the following matrix into reduced row echelon form
        (RREF).  Indicate which columns are pivot columns.
        <m>\begin{pmatrix}-3 \amp 4 \amp 7 \\ 2 \amp 1 \amp -1 \\ 3 \amp 1 \amp -2 \\ -2 \amp 2 \amp 4\end{pmatrix}</m>.</p>
    </statement>
    <solution>
      <p>Try this problem using the Interactive Row Reducer
          <url href="https://textbooks.math.gatech.edu/ila/demos/rrinter.html?mat=-3,4,7:2,1,-1:3,1,-2:-2,2,4">here</url>.</p>
      <p>The quickest way might be to switch the first and fourth rows and
          then divide the new first row by <m>-2</m> to make the numbers work
          nicely.</p>
      <p>
        Columns 1 and 2 are the pivot columns, and the RREF of the matrix
            is
        <md><mrow>\begin{pmatrix}1 \amp 0 \amp -1 \\ 0 \amp 1 \amp 1 \\ 0 \amp 0 \amp 0 \\ 0 \amp 0 \amp 0\end{pmatrix}</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Put the following matrix <m>A</m> into reduced row echelon form
        (RREF).  Indicate which columns are pivot columns.  Is the
        corresponding system of linear equations consistent or inconsistent?
        <m>\left(\begin{array}{rrr|r}5 \amp 10 \amp -5 \amp 40 \\ 4 \amp -2 \amp 36 \amp -28 \\ 3 \amp 20 \amp 9 \amp 40\end{array}\right)</m>.</p>
    </statement>
    <solution>
      <p>Try this problem using the Interactive Row Reducer
          <url href="https://textbooks.math.gatech.edu/ila/demos/rrinter.html?mat=5,10,-5,8:4,-2,36,-28:3,20,9,40">here</url>.</p>
      <p>
        One way to do this problem is to divide the first row by <m>5</m> and
            then do row operations to create zeros below the first entry of
            the left column.  Once we do this, we see that the second column
            is also pivot column.  Doing one more row operation gives us a row
            echelon form of the matrix, whereby we see all three columns to
            the left of the augment bar are pivot columns.  One row echelon form
            of the augmented matrix is
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 2 \amp -1 \amp 8 \\ 0 \amp 1 \amp -4 \amp 6 \\ 0 \amp 0 \amp 68 \amp -68\end{array}\right)</mrow></md>.
      </p>
      <p>
        We keep row-reducing to get the RREF of the augmented matrix:
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp 3 \\ 0 \amp 1 \amp 0 \amp 2 \\ 0 \amp 0 \amp 1 \amp -1\end{array}\right)</mrow></md>.
        This system is consistent, with unique solution <m>x = 3</m>, <m>y = 2</m>,
            <m>z = -1</m>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Write an augmented matrix in RREF with three pivots that
        represents an inconsistent system of three equations in four
        variables.</p>
    </statement>
    <solution>
      <p>
        Many possibilities.  For example,
        <md><mrow>\left(\begin{array}{rrrr|r}1 \amp 0 \amp 0 \amp 0 \amp 0 \\ 0 \amp 1 \amp 0 \amp 0 \amp 0 \\ 0 \amp 0 \amp 0 \amp 0 \amp 1\end{array}\right),
                \qquad \left(\begin{array}{rrrr|r}0 \amp 1 \amp 0 \amp 0 \amp 0 \\ 0 \amp 0 \amp 1 \amp 0 \amp 0 \\ 0 \amp 0 \amp 0 \amp 0 \amp 1\end{array}\right), \quad \textup{
                  or } \quad \left(\begin{array}{rrrr|r}0 \amp 0 \amp 1 \amp 0 \amp 0 \\ 0 \amp 0 \amp 0 \amp 1 \amp 0 \\ 0 \amp 0 \amp 0 \amp 0 \amp 1\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Is there a system of three equations in two variables
          that has infinitely many solutions?  If your answer is yes, write
          an augmented matrix in RREF that represents one such system.</p>
    </statement>
    <solution>
      <p>
        Yes.  For example, consider the system
        <md><mrow>x + y = 1</mrow></md>
        <md><mrow>2x + 2y = 2</mrow></md>
        <md><mrow>3x + 3y = 3</mrow></md>.
        Each equation represents the line <m>x + y = 1</m>,
            so the solution set is all points <m>(x,y)</m> on the line <m>y =
            1-x</m>. The corresponding augmented matrix and its RREF are
        <md><mrow>\left(\begin{array}{rr|r}1 \amp 1 \amp 1 \\ 2 \amp 2 \amp 2 \\ 3 \amp 3 \amp 3\end{array}\right) \xrightarrow[]{RREF} \left(\begin{array}{rr|r}1 \amp 1 \amp 1 \\ 0 \amp 0 \amp 0 \\ 0 \amp 0 \amp 0\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Row reduce the matrix to determine whether its
          corresponding system of linear equations is consistent.
        <md><mrow>\left(\begin{array}{rrrr|r}3 \amp -2 \amp 11 \amp 2 \amp 5 \\ 0 \amp 1 \amp -1 \amp 2 \amp 3 \\ 1 \amp 0 \amp 3 \amp 2 \amp -1\end{array}\right)</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        We swap the first and third rows to begin.
        <md>
          <mrow>\left(\begin{array}{rrrr|r}3 \amp -2 \amp 11 \amp 2 \amp 5</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2 \amp 3</mrow>
          <mrow>1 \amp 0 \amp 3 \amp 2 \amp -1\end{array}\right)
              \xrightarrow[]{R_1 \leftrightarrow R_3}
              \amp
                \left(\begin{array}{rrrr|r}1 \amp 0 \amp 3 \amp 2 \amp -1</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2 \amp 3</mrow>
          <mrow>3 \amp -2 \amp 11 \amp 2 \amp 5\end{array}\right)</mrow>
          <mrow>\xrightarrow[]{R_3 = R_3 - 3 R_1}
              \amp
                \left(\begin{array}{rrrr|r}1 \amp 0 \amp 3 \amp 2 \amp -1</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2 \amp 3</mrow>
          <mrow>0 \amp -2 \amp 2 \amp -4 \amp 8\end{array}\right)</mrow>
          <mrow>\xrightarrow[]{R_3 = R_3 + 2R_2}
              \amp
                \left(\begin{array}{rrrr|r}1 \amp 0 \amp 3 \amp 2 \amp -1</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2 \amp 3</mrow>
          <mrow>0 \amp 0 \amp 0 \amp 0 \amp 14\end{array}\right)</mrow>
        </md>
        We do not need to row-reduce any further because we have found
            a pivot in the rightmost column, therefore the system is inconsistent.
            The final row of the augmented matrix corresponds to the equations
            <q><m>0 = 14</m>.</q>
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>Are there three lines in the <m>xy</m>-plane (not necessarily
        distinct lines) whose common intersection is exactly one point?  If
        so, give an example and write an augmented matrix for the
        corresponding system of linear equations in <m>x</m> and <m>y</m>.</p>
    </statement>
    <solution>
      <p>
        Yes.  For example, take the lines <m>x - y = 0</m>, <m>2x-2y = 0</m>, and
            <m>y =1</m>.  The first two lines are the same line, which intersects
            the non-parallel line <m>y=1</m> at exactly one point, namely when
            <m>x=y=1</m>. To illustrate the example, we solve the augmented system
            below to find the unique solution.
        <md>
          <mrow>\left(\begin{array}{rr|r}1 \amp -1 \amp 0</mrow>
          <mrow>2 \amp -2 \amp 0</mrow>
          <mrow>0 \amp 1 \amp 1\end{array}\right)
              \amp  \xrightarrow[]{R_2 = R_2 -2R_1}
                \left(\begin{array}{rr|r}1 \amp -1 \amp 0</mrow>
          <mrow>0 \amp 0 \amp 0</mrow>
          <mrow>0 \amp 1 \amp 1\end{array}\right) \xrightarrow[]{R_1 \leftrightarrow R_2}
                \left(\begin{array}{rr|r}1 \amp -1 \amp 0</mrow>
          <mrow>0 \amp 1 \amp 1</mrow>
          <mrow>0 \amp 0 \amp 0\end{array}\right) \xrightarrow[]{R_1 = R_1 + R_2}
                \left(\begin{array}{rr|r}1 \amp 0 \amp 1</mrow>
          <mrow>0 \amp 1 \amp 1</mrow>
          <mrow>0 \amp 0 \amp 0\end{array}\right)</mrow>
        </md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Write the following system of equations in augmented matrix
          form, and put the matrix into RREF.  After this, write two solutions
          <m>(x_1, x_2, x_3)</m>
          to the system of equations.
        <md><mrow>2x_1 - 3x_2 + x_3 = 6</mrow></md>
        <md><mrow>x_1 - x_2 = 4</mrow></md>
        <md><mrow>x_2 - x_3 = 2</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        We put this into an augmented matrix and row-reduce:
        <md>
          <mrow>\left(\begin{array}{rrr|r}2 \amp -3 \amp 1 \amp 6</mrow>
          <mrow>1 \amp -1 \amp 0 \amp 4</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2\end{array}\right)
              \amp
                \xrightarrow[]{R_1 \leftrightarrow R_2}
                \left(\begin{array}{rrr|r}1 \amp -1 \amp 0 \amp 4</mrow>
          <mrow>2 \amp -3 \amp 1 \amp 6</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2\end{array}\right)
                \xrightarrow[]{R_2 = R_2 - 2 R_1}
                \left(\begin{array}{rrr|r}1 \amp -1 \amp 0 \amp 4</mrow>
          <mrow>0 \amp -1 \amp 1 \amp 2</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2\end{array}\right)</mrow>
          <mrow>\amp
                \xrightarrow[\textup{then } R_3 = R_3 - R_2]{R_2 = (-1)*R_2}
                \left(\begin{array}{rrr|r}1 \amp -1 \amp 0 \amp 4</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2</mrow>
          <mrow>0 \amp 0 \amp 0 \amp 0\end{array}\right)
                \xrightarrow[]{R_1 = R_1 + R_2}
                \left(\begin{array}{rrr|r}1 \amp 0 \amp -1 \amp 6</mrow>
          <mrow>0 \amp 1 \amp -1 \amp 2</mrow>
          <mrow>0 \amp 0 \amp 0 \amp 0\end{array}\right)</mrow>
        </md>.
        Now that we have found the RREF of the matrix, we see that
            <m>(x_1, x_2, x_3)</m> is a solution as long as <m>x_1 - x_3 = 6</m> and
            <m>x_2 - x_3 = 2</m>.  To find a solution, we could just pre-set our
            favorite value for one of the variables and see if we could solve
            for the others.  For example, if we set <m>x_1 = 1</m>, then
            to satisfy <m>x_1 - x_3 = 6</m> we need <m>x_3 = -5</m>, and now the second
            equation becomes
        <md><mrow>x_2 - x_3 = 2, \qquad x_2 - (-5) = 2, \qquad x_2 = -3</mrow></md>.
        Therefore, <m>(1, -3, -5)</m> is a solution.
      </p>
      <p>To get a second solution, we could set <m>x_3 = 0</m> and solve for <m>x_1</m>
          and <m>x_2</m>:  <m>x_1 - x_3 = 6</m> gives <m>x_1 = 6</m>, and then <m>x_2-x_3 = 2</m>
          gives <m>x_2 = 2</m>, so <m>(6, 2, 0)</m> is a second solution.</p>
      <p>In reality, there are infinitely many solutions to this system of
          equations.  We'll see in section 1.3 that this consistent system
          has <m>x_3</m> as a <em>free</em> variable because its column does not
          have a pivot, which means that we can set <m>x_3</m> equal to any real
          number and then solve for <m>x_1</m> and <m>x_2</m>.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Find all values of <m>h</m> so that the following system has at least one solution.
        <md><mrow>x + y = 1</mrow></md>
        <md><mrow>2x + 2y = h</mrow></md>.
      </p>
    </statement>
    <solution>
      <p>
        The answer is <m>h=2</m> only.  Subtracting two times the first equation from the second equation gives us
        <md><mrow>x+y = 1</mrow></md>
        <md><mrow>0 = h - 2</mrow></md>.
        The system will be consistent as long as <m>h-2 = 0</m> (so <m>h=2</m>).  In this case, the system has infinitely many solutions since both equations will describe the same line <m>x+y = 1</m>.
      </p>
      <p>If <m>h \neq 2</m>, then the equation <m>0= h-2</m> will not be satisfied, so the system is inconsistent.</p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Extra practice with row reduction that you can check using the interactive row reducer.  Put the following matrix into reduced row echelon form (RREF).
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 2 \amp 3 \amp 9 \\ 2 \amp -1 \amp 1 \amp 8 \\ 3 \amp 0 \amp -1 \amp 3\end{array}\right)</mrow></md>
      </p>
    </statement>
    <solution>
      <p>
        You can check your work using the interactive row reducer
              <url href="https://textbooks.math.gatech.edu/ila/demos/rrinter.html?mat=1,2,3,9:2,-1,1,8:3,0,-1,3">here</url>.
              The RREF is
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp 2 \\ 0 \amp 1 \amp 0 \amp -1 \\ 0 \amp 0 \amp 1 \amp 3\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Extra practice with row reduction that you can check using the interactive row reducer.  Put the following matrix into reduced row echelon form (RREF).
        <md><mrow>\left(\begin{array}{rrr|r}0 \amp 7 \amp -4 \amp 2 \\ 2 \amp 4 \amp 6 \amp 12 \\ 3 \amp 1 \amp -1 \amp -2\end{array}\right)</mrow></md>
      </p>
    </statement>
    <solution>
      <p>
        You can check your work using the interactive row reducer
              <url href="https://textbooks.math.gatech.edu/ila/demos/rrinter.html?mat=0,7,-4,2:2,4,6,12:3,1,-1,-2">here</url>.
              The RREF is
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp -5/9 \\ 0 \amp 1 \amp 0 \amp 10/9 \\ 0 \amp 0 \amp 1 \amp 13/9\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
  <exercise>
    <statement>
      <p>
        Extra practice with row reduction that you can check using the interactive row reducer.  Put the following matrix into reduced row echelon form (RREF).
        <md><mrow>\left(\begin{array}{rrr|r}4 \amp -5 \amp 3 \amp 2 \\ 1 \amp -1 \amp -2 \amp -6 \\ 4 \amp -4 \amp -14 \amp 18\end{array}\right)</mrow></md>
      </p>
    </statement>
    <solution>
      <p>
        You can check your work using the interactive row reducer
              <url href="https://textbooks.math.gatech.edu/ila/demos/rrinter.html?mat=4,-5,3,2:1,-1,-2,-6:4,-4,-14,18">here</url>.
              The RREF is
        <md><mrow>\left(\begin{array}{rrr|r}1 \amp 0 \amp 0 \amp -123 \\ 0 \amp 1 \amp 0 \amp -103 \\ 0 \amp 0 \amp 1 \amp -7\end{array}\right)</mrow></md>.
      </p>
    </solution>
  </exercise>
</exercises> 
</section>
