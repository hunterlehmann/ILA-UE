  \node (A) at (0,-3.5) {$\R^n$};
  \node (B) at (8,-3.5) {$\R^m$};
  \draw[->] (A.east) +(5mm,0) -- node[midway,above=1mm] {$b=Ax$}
    ($(B.west)-(5mm,0)$);

  \point["$x$" left] (P) at (1,1,5);

  \begin{scope}[myxyz, xshift=8cm]
